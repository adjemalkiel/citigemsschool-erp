# Citigems ERPNext v15 — copy to docker/.env and adjust.
#   cp docker/.env.example docker/.env

CUSTOM_IMAGE=citigems/erpnext
CUSTOM_TAG=16
PULL_POLICY=missing
ERPNEXT_VERSION=v16

SITE_NAME=erp.citigemsschool.com
FRAPPE_SITE_NAME_HEADER=erp.citigemsschool.com
HTTP_PUBLISH_PORT=8080

# Local-only alternative:
# SITE_NAME=citigems.localhost
# FRAPPE_SITE_NAME_HEADER=citigems.localhost

# Secrets — also mirrored under secrets/ by bootstrap (gitignored)
DB_PASSWORD=change-me
ADMIN_PASSWORD=change-me

# Low-RAM defaults (~8GB host)
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# Optional: drive a remote Docker daemon (e.g. when local user lacks docker group)
# DOCKER_HOST=ssh://devops-docker
# When using a remote daemon that already publishes :8080, use another host port:
# HTTP_PUBLISH_PORT=18080
